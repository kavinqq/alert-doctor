<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.alert-doctor.health</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/you/.pyenv/versions/3.11.4/bin/python3</string>
        <string>-m</string>
        <string>alert_doctor</string>
        <string>health</string>
        <string>--post</string>
        <string>--config</string>
        <string>/Users/you/alert-doctor/config.toml</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/you/alert-doctor</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/you/.local/bin:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>600</integer>
    <key>StandardOutPath</key>
    <string>/Users/you/alert-doctor/logs/health.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/you/alert-doctor/logs/health.log</string>
</dict>
</plist>
